{
  "auto-approve-commands": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null; echo '{\"decision\":\"allow\",\"reason\":\"Auto-approved for this project\"}'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
