# MongoDB Atlas connection string (replace <db_password>), and the database name to use
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=daybook

# Auth.js: a random string, e.g. `openssl rand -base64 33`
AUTH_SECRET=

# Google OAuth client (redirect: <site>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production only, when not on Vercel: the public URL, e.g. https://daybook.example.com
# AUTH_URL=

# Analytics dashboard at /analytics: the Google account email(s) allowed to see it, comma-separated.
# Leave empty and the page does not exist for anyone.
ANALYTICS_OWNER_EMAIL=
# Page views are only recorded in production. Set to 1 to also record them from `next dev`
# (it uses the same database as production unless MONGODB_DB differs).
# ANALYTICS_TRACK_DEV=1
